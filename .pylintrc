[MASTER]

ignore-paths=src/tests, src/db_helper.py
ignore=single_file_to_ignore.py

[MESSAGE-CONTROL]

disable=raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        use-symbolic-message-instead,
        missing-module-docstring,
        missing-function-docstring,
        missing-class-docstring,
        broad-exception-caught, #Exception in app.py
        redefined-builtin, #references.py id 
        too-few-public-methods #references.py class

[FORMAT]

[REFRACTORING]
max-nested-blocks = 2

[DESIGN]
max-statements = 10
